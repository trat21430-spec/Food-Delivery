        <mxCell id="52" value="&lt;b&gt;UC38: Phê duyệt đơn &amp;&lt;/b&gt;&lt;br&gt;Tự động tạo hồ sơ Driver" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2335" y="276" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="53" value="&lt;b&gt;UC39: Từ chối hồ sơ&lt;/b&gt;&lt;br&gt;Ứng tuyển tài xế" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2335" y="366" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="54" value="&lt;b&gt;UC31: Quét hàng đợi&lt;/b&gt;&lt;br&gt;Đơn hàng PENDING" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="836" width="260" height="68" as="geometry" />
        </mxCell>
        <mxCell id="55" value="&lt;b&gt;UC34: Tự động ghép nối&lt;/b&gt;&lt;br&gt;&amp; Khóa tài xế (BUSY)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="1004" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="56" value="&lt;b&gt;UC32: Tìm kiếm tài xế&lt;/b&gt;&lt;br&gt;Gần nhất (Haversine)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2335" y="946" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="57" value="&lt;b&gt;UC33: Tính toán thời gian&lt;/b&gt;&lt;br&gt;Dự kiến giao hàng (ETA)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2335" y="1066" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="58" value="&lt;b&gt;UC43: Cấu hình tham số&lt;/b&gt;&lt;br&gt;Kiểm thử (Threads/Lock)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="1426" width="260" height="68" as="geometry" />
        </mxCell>
        <mxCell id="59" value="&lt;b&gt;UC44: Kích hoạt mô phỏng&lt;/b&gt;&lt;br&gt;Đa luồng đồng thời" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2640" y="1544" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="60" value="&lt;b&gt;UC47: So chuẩn 4 cơ chế khóa&lt;/b&gt;&lt;br&gt;(NO/SYNC/OPT/FILE)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
