        <mxCell id="53" value="&lt;b&gt;UC29: Xem danh sách đơn&lt;/b&gt;&lt;br&gt;Chờ điều phối (PENDING)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2700" y="827" width="260" height="66" as="geometry" />
