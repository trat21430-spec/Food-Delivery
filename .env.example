# ==============================================================================
# FOOD DELIVERY NETWORK SIMULATION (FDS) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0
APP_ENV=production

# Persistence Paths
DATA_DIR=data
WEB_ROOT=web

# Business Financial Commission Rules (LAB211 Standard)
PLATFORM_COMMISSION_PERCENT=20
RESTAURANT_PAYOUT_PERCENT=80
DRIVER_SHIPPING_FEE_BASE=15000
DISTANCE_FEE_PER_KM=5000

# VietQR Payment Gateway Settings
VIETQR_BANK_CODE=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME="FOOD DELIVERY QUY NHON"
VIETQR_TEMPLATE=compact2

# Concurrency & Performance Tuning
THREAD_POOL_SIZE=64
SSE_HEARTBEAT_SECONDS=15
