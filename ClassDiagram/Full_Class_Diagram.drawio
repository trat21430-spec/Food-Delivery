<mxfile host="app.diagrams.net">
  <diagram id="FullClassDiagramLAB211" name="Food Delivery Simulation Full Class Diagram">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml&#xa;title FOOD DELIVERY NETWORK SIMULATION - FULL CLASS DIAGRAM (MVC)&#xa;skinparam classAttributeIconSize 0&#xa;skinparam monochrome false&#xa;skinparam packageStyle rectangle&#xa;skinparam backgroundColor #FFFFFF&#xa;skinparam linetype ortho&#xa;&#xa;package &quot;1. Model Layer&quot; {&#xa;    abstract class BaseEntity {&#xa;        - String id&#xa;        - LocalDateTime createdAt&#xa;        - LocalDateTime updatedAt&#xa;        - long version&#xa;        + BaseEntity()&#xa;        + BaseEntity(id: String)&#xa;        + BaseEntity(id: String, createdAt: LocalDateTime, updatedAt: LocalDateTime, version: long)&#xa;        + getId(): String&#xa;        + setId(id: String): void&#xa;        + getCreatedAt(): LocalDateTime&#xa;        + setCreatedAt(createdAt: LocalDateTime): void&#xa;        + getUpdatedAt(): LocalDateTime&#xa;        + setUpdatedAt(updatedAt: LocalDateTime): void&#xa;        + getVersion(): long&#xa;        + setVersion(version: long): void&#xa;        + incrementVersion(): void&#xa;        + {abstract} toCsvLine(): String&#xa;        + {abstract} fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class Customer {&#xa;        - String fullName&#xa;        - String phone&#xa;        - String ward&#xa;        - double latitude&#xa;        - double longitude&#xa;        + Customer()&#xa;        + Customer(id, fullName, phone, ward, lat, lon)&#xa;        + getFullName(): String&#xa;        + setFullName(fullName: String): void&#xa;        + getPhone(): String&#xa;        + setPhone(phone: String): void&#xa;        + getWard(): String&#xa;        + setWard(ward: String): void&#xa;        + getLatitude(): double&#xa;        + getLongitude(): double&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class Restaurant {&#xa;        - String name&#xa;        - String category&#xa;        - String address&#xa;        - double latitude&#xa;        - double longitude&#xa;        - double rating&#xa;        - boolean open&#xa;        + Restaurant()&#xa;        + Restaurant(id, name, cat, addr, lat, lon, rating, open)&#xa;        + getName(): String&#xa;        + getAddress(): String&#xa;        + getLatitude(): double&#xa;        + getLongitude(): double&#xa;        + getRating(): double&#xa;        + isOpen(): boolean&#xa;        + setOpen(open: boolean): void&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class MenuItem {&#xa;        - String restaurantId&#xa;        - String name&#xa;        - double priceVnd&#xa;        - int stockQty&#xa;        + MenuItem()&#xa;        + MenuItem(id, restId, name, price, stock, version)&#xa;        + getRestaurantId(): String&#xa;        + getName(): String&#xa;        + getPriceVnd(): double&#xa;        + getStockQty(): int&#xa;        + setStockQty(stockQty: int): void&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class Driver {&#xa;        - String fullName&#xa;        - String phone&#xa;        - String licensePlate&#xa;        - double latitude&#xa;        - double longitude&#xa;        - DriverStatus status&#xa;        - int activeOrderCount&#xa;        - String currentOrderId&#xa;        + Driver()&#xa;        + Driver(id, name, phone, plate, lat, lon, status, count, version)&#xa;        + getFullName(): String&#xa;        + getLicensePlate(): String&#xa;        + getLatitude(): double&#xa;        + getLongitude(): double&#xa;        + getStatus(): DriverStatus&#xa;        + setStatus(status: DriverStatus): void&#xa;        + getCurrentOrderId(): String&#xa;        + setCurrentOrderId(orderId: String): void&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class DriverApplication {&#xa;        - String username&#xa;        - String password&#xa;        - String fullName&#xa;        - String phone&#xa;        - String licensePlate&#xa;        - String vehicleType&#xa;        - String status&#xa;        - String note&#xa;        + DriverApplication()&#xa;        + DriverApplication(id, user, pass, name, phone, plate, type, status, note)&#xa;        + getUsername(): String&#xa;        + getStatus(): String&#xa;        + setStatus(status: String): void&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class Order {&#xa;        - String customerId&#xa;        - String restaurantId&#xa;        - String driverId&#xa;        - OrderStatus status&#xa;        - double totalFoodAmount&#xa;        - double deliveryFee&#xa;        - long createdAtEpochMs&#xa;        - int assignCount&#xa;        + Order()&#xa;        + Order(id, custId, restId, driverId, status, total, fee, epoch, count, version)&#xa;        + getCustomerId(): String&#xa;        + getRestaurantId(): String&#xa;        + getDriverId(): String&#xa;        + setDriverId(driverId: String): void&#xa;        + getStatus(): OrderStatus&#xa;        + setStatus(status: OrderStatus): void&#xa;        + getTotalAmount(): double&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class OrderItem {&#xa;        - String orderId&#xa;        - String menuItemId&#xa;        - int quantity&#xa;        - double unitPriceVnd&#xa;        + OrderItem()&#xa;        + OrderItem(id, orderId, menuItemId, quantity, unitPrice)&#xa;        + getOrderId(): String&#xa;        + getMenuItemId(): String&#xa;        + getQuantity(): int&#xa;        + getUnitPriceVnd(): double&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class DeliveryRoute {&#xa;        - String orderId&#xa;        - String driverId&#xa;        - double pickupDistanceKm&#xa;        - double deliveryDistanceKm&#xa;        - int estimatedMinutes&#xa;        + DeliveryRoute()&#xa;        + DeliveryRoute(id, orderId, driverId, pickupDist, delivDist, mins)&#xa;        + getPickupDistanceKm(): double&#xa;        + getDeliveryDistanceKm(): double&#xa;        + getEstimatedMinutes(): int&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class SimulationRun {&#xa;        - LockMechanism mechanism&#xa;        - int totalOrders&#xa;        - long durationMs&#xa;        - double throughputOpsPerSec&#xa;        - double throughputDropPercent&#xa;        - int doubleAssignErrors&#xa;        - int oversellErrors&#xa;        - int driverOverloadErrors&#xa;        + SimulationRun()&#xa;        + SimulationRun(id, mechanism, total, duration, throughput, drop, dAssign, oversell, dOverload)&#xa;        + getMechanism(): LockMechanism&#xa;        + getThroughputOpsPerSec(): double&#xa;        + getTotalErrors(): int&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class User {&#xa;        - String username&#xa;        - String password&#xa;        - UserRole role&#xa;        - String linkedEntityId&#xa;        - String displayName&#xa;        - String phone&#xa;        + User()&#xa;        + User(id, user, pass, role, linkedId, name, created, updated, version)&#xa;        + getUsername(): String&#xa;        + getRole(): UserRole&#xa;        + getLinkedEntityId(): String&#xa;        + getDisplayName(): String&#xa;        + toCsvLine(): String&#xa;        + fromCsvLine(line: String): void&#xa;    }&#xa;&#xa;    class UserAccount {&#xa;        + UserAccount()&#xa;        + UserAccount(id, user, pass, phone, name, role, custId, driverId, active)&#xa;    }&#xa;&#xa;    class GeoUtils {&#xa;        - double earthRadiusKm&#xa;        + GeoUtils()&#xa;        + haversineDistance(lat1, lon1, lat2, lon2): double&#xa;        + calculateDeliveryFee(distanceKm: double): double&#xa;        + calculatePickupMinutes(driverToRestKm: double): int&#xa;        + calculateDeliveryMinutes(driverToRestKm, restToCustKm): int&#xa;        + formatEstimatedClockTime(baseEpochMs, durationMins): String&#xa;    }&#xa;&#xa;    enum DriverStatus {&#xa;        AVAILABLE&#xa;        BUSY&#xa;        OFFLINE&#xa;    }&#xa;&#xa;    enum OrderStatus {&#xa;        PENDING&#xa;        CONFIRMED&#xa;        DISPATCHED&#xa;        DELIVERED&#xa;        CANCELLED&#xa;    }&#xa;&#xa;    enum UserRole {&#xa;        CUSTOMER&#xa;        DRIVER&#xa;        RESTAURANT&#xa;        ADMIN&#xa;    }&#xa;&#xa;    enum LockMechanism {&#xa;        NO_LOCK&#xa;        SYNCHRONIZED&#xa;        OPTIMISTIC&#xa;        FILE_LOCK&#xa;    }&#xa;&#xa;    BaseEntity &lt;|-- Customer&#xa;    BaseEntity &lt;|-- Restaurant&#xa;    BaseEntity &lt;|-- MenuItem&#xa;    BaseEntity &lt;|-- Driver&#xa;    BaseEntity &lt;|-- DriverApplication&#xa;    BaseEntity &lt;|-- Order&#xa;    BaseEntity &lt;|-- OrderItem&#xa;    BaseEntity &lt;|-- DeliveryRoute&#xa;    BaseEntity &lt;|-- SimulationRun&#xa;    BaseEntity &lt;|-- User&#xa;    User &lt;|-- UserAccount&#xa;}&#xa;&#xa;package &quot;2. Repository Layer&quot; {&#xa;    interface IRepository&lt;T&gt; {&#xa;        + findAll(): List&lt;T&gt;&#xa;        + findById(id: String): T&#xa;        + save(entity: T): void&#xa;        + saveAll(entities: List&lt;T&gt;): void&#xa;        + deleteById(id: String): void&#xa;    }&#xa;&#xa;    abstract class CsvRepository&lt;T&gt; {&#xa;        - String filePath&#xa;        - String header&#xa;        - Object fileMonitor&#xa;        - ConcurrentHashMap&lt;String, Object&gt; keyLocks&#xa;        + CsvRepository(filePath: String, header: String)&#xa;        + {abstract} createEntity(): T&#xa;        + parseLine(line: String): T&#xa;        + findAll(): List&lt;T&gt;&#xa;        + findById(id: String): T&#xa;        + save(entity: T): void&#xa;        + saveAll(entities: List&lt;T&gt;): void&#xa;        + deleteById(id: String): void&#xa;        + getKeyLock(key: String): Object&#xa;        + executeWithFileLock(action: Runnable): void&#xa;        + updateWithOptimisticLock(entity: T, expectedVersion: long): void&#xa;    }&#xa;&#xa;    class CustomerRepository {&#xa;        + CustomerRepository()&#xa;        + createEntity(): Customer&#xa;    }&#xa;&#xa;    class RestaurantRepository {&#xa;        + RestaurantRepository()&#xa;        + createEntity(): Restaurant&#xa;    }&#xa;&#xa;    class MenuItemRepository {&#xa;        + MenuItemRepository()&#xa;        + createEntity(): MenuItem&#xa;        + findByRestaurantId(restaurantId: String): List&lt;MenuItem&gt;&#xa;        + deductStock(menuItemId, quantity, mechanism): boolean&#xa;        + restoreStock(menuItemId, quantity): boolean&#xa;    }&#xa;&#xa;    class DriverRepository {&#xa;        - GeoUtils geoUtils&#xa;        + DriverRepository()&#xa;        + createEntity(): Driver&#xa;        + findAvailableDrivers(): List&lt;Driver&gt;&#xa;        + findNearestAvailable(restLat, restLon): Driver&#xa;        + markBusy(driverId, orderId, mechanism): boolean&#xa;        + markAvailable(driverId: String): boolean&#xa;    }&#xa;&#xa;    class DriverApplicationRepository {&#xa;        + DriverApplicationRepository()&#xa;        + createEntity(): DriverApplication&#xa;        + findPendingApplications(): List&lt;DriverApplication&gt;&#xa;        + findByUsername(username: String): DriverApplication&#xa;        + findByPhone(phone: String): DriverApplication&#xa;    }&#xa;&#xa;    class OrderRepository {&#xa;        + OrderRepository()&#xa;        + createEntity(): Order&#xa;        + processOrderAndDispatch(custId, restId, itemId, qty, mech, ...): Order&#xa;        + dispatchPendingOrder(orderId, mech, ...): boolean&#xa;        + autoDispatchAllPending(mech, ...): List&lt;String&gt;&#xa;        + dispatchOrderToDriver(orderId, driverId, mech): boolean&#xa;        + assignDriver(orderId, driverId, mech): boolean&#xa;    }&#xa;&#xa;    class OrderItemRepository {&#xa;        + OrderItemRepository()&#xa;        + createEntity(): OrderItem&#xa;        + findByOrderId(orderId: String): List&lt;OrderItem&gt;&#xa;    }&#xa;&#xa;    class DeliveryRouteRepository {&#xa;        + DeliveryRouteRepository()&#xa;        + createEntity(): DeliveryRoute&#xa;    }&#xa;&#xa;    class SimulationRunRepository {&#xa;        + SimulationRunRepository()&#xa;        + createEntity(): SimulationRun&#xa;    }&#xa;&#xa;    class UserRepository {&#xa;        + UserRepository()&#xa;        + createEntity(): User&#xa;        + findByUsername(username: String): User&#xa;        + findByPhone(phone: String): User&#xa;    }&#xa;&#xa;    IRepository &lt;|.. CsvRepository&#xa;    CsvRepository &lt;|-- CustomerRepository&#xa;    CsvRepository &lt;|-- RestaurantRepository&#xa;    CsvRepository &lt;|-- MenuItemRepository&#xa;    CsvRepository &lt;|-- DriverRepository&#xa;    CsvRepository &lt;|-- DriverApplicationRepository&#xa;    CsvRepository &lt;|-- OrderRepository&#xa;    CsvRepository &lt;|-- OrderItemRepository&#xa;    CsvRepository &lt;|-- DeliveryRouteRepository&#xa;    CsvRepository &lt;|-- SimulationRunRepository&#xa;    CsvRepository &lt;|-- UserRepository&#xa;    DriverRepository o-- GeoUtils&#xa;}&#xa;&#xa;package &quot;3. Controller Layer&quot; {&#xa;    class MainController {&#xa;        - AuthController authController&#xa;        - CustomerController customerController&#xa;        - RestaurantController restaurantController&#xa;        - DriverController driverController&#xa;        - OrderController orderController&#xa;        - SimulatorController simulatorController&#xa;        - AdminController adminController&#xa;        - MainView mainView&#xa;        + MainController()&#xa;        + run(): void&#xa;        + login(username, password): boolean&#xa;        + logout(): void&#xa;        + getCurrentUser(): User&#xa;    }&#xa;&#xa;    class AppController {&#xa;        + AppController()&#xa;    }&#xa;&#xa;    class AuthController {&#xa;        - UserRepository userRepository&#xa;        - CustomerRepository customerRepository&#xa;        - DriverRepository driverRepository&#xa;        - DriverApplicationRepository driverAppRepository&#xa;        - User currentUser&#xa;        + AuthController()&#xa;        + login(username, password): boolean&#xa;        + logout(): void&#xa;        + registerCustomer(...): User&#xa;        + submitDriverApplication(...): DriverApplication&#xa;        + registerDriver(...): User&#xa;    }&#xa;&#xa;    class CustomerController {&#xa;        - CustomerRepository customerRepository&#xa;        - OrderRepository orderRepository&#xa;        + CustomerController()&#xa;        + registerCustomer(...): Customer&#xa;        + getAllCustomers(): List&lt;Customer&gt;&#xa;        + getCustomerById(id: String): Customer&#xa;        + updateCustomer(...): boolean&#xa;        + getOrderHistory(customerId: String): List&lt;Order&gt;&#xa;    }&#xa;&#xa;    class DriverController {&#xa;        - DriverRepository driverRepository&#xa;        + DriverController()&#xa;        + getAllDrivers(): List&lt;Driver&gt;&#xa;        + getAvailableDrivers(): List&lt;Driver&gt;&#xa;        + getNearestAvailableDriver(lat, lon): Driver&#xa;        + updateDriverStatus(id, status): boolean&#xa;    }&#xa;&#xa;    class RestaurantController {&#xa;        - RestaurantRepository restaurantRepository&#xa;        - MenuItemRepository menuItemRepository&#xa;        + RestaurantController()&#xa;        + getAllRestaurants(): List&lt;Restaurant&gt;&#xa;        + getMenuByRestaurant(restaurantId: String): List&lt;MenuItem&gt;&#xa;        + updateStock(menuItemId, newStock): boolean&#xa;    }&#xa;&#xa;    class OrderController {&#xa;        - OrderRepository orderRepository&#xa;        - MenuItemRepository menuItemRepository&#xa;        - DriverRepository driverRepository&#xa;        - RestaurantRepository restaurantRepository&#xa;        - OrderItemRepository orderItemRepository&#xa;        - CustomerRepository customerRepository&#xa;        - DeliveryRouteRepository routeRepository&#xa;        + OrderController()&#xa;        + placeOrderAndDispatch(...): Order&#xa;        + confirmOrderByRestaurant(...): Order&#xa;        + rejectOrderByRestaurant(...): boolean&#xa;        + cancelOrderByCustomer(...): boolean&#xa;        + markOrderPickedUp(...): boolean&#xa;        + markOrderDelivered(...): boolean&#xa;        + autoDispatchPendingOrders(mechanism): int&#xa;    }&#xa;&#xa;    class AdminController {&#xa;        - RestaurantRepository restaurantRepo&#xa;        - MenuItemRepository menuItemRepo&#xa;        - CustomerRepository customerRepo&#xa;        - DriverRepository driverRepo&#xa;        - DriverApplicationRepository driverAppRepo&#xa;        - UserRepository userRepo&#xa;        + AdminController()&#xa;        + getPendingDriverApplications(): List&lt;DriverApplication&gt;&#xa;        + approveDriverApplication(id): User&#xa;        + rejectDriverApplication(id, reason): boolean&#xa;        + addRestaurant(...): Restaurant&#xa;        + restockMenuItem(itemId, qty): void&#xa;    }&#xa;&#xa;    class SimulatorController {&#xa;        - OrderRepository orderRepo&#xa;        - DriverRepository driverRepo&#xa;        - MenuItemRepository menuItemRepo&#xa;        - SimulationRunRepository simRunRepo&#xa;        + SimulatorController()&#xa;        + runSimulation(numOrders, mechanism): SimulationRun&#xa;        + detectDoubleAssignments(): int&#xa;        + detectOversellItems(): int&#xa;        + detectDriverOverload(): int&#xa;    }&#xa;&#xa;    class CustomerThread extends Thread {&#xa;        - OrderController orderController&#xa;        - LockMechanism mechanism&#xa;        + run(): void&#xa;    }&#xa;&#xa;    class DispatchThread extends Thread {&#xa;        - OrderController orderController&#xa;        - LockMechanism mechanism&#xa;        + run(): void&#xa;    }&#xa;&#xa;    MainController &lt;|-- AppController&#xa;    MainController *-- AuthController&#xa;    MainController *-- CustomerController&#xa;    MainController *-- RestaurantController&#xa;    MainController *-- DriverController&#xa;    MainController *-- OrderController&#xa;    MainController *-- SimulatorController&#xa;    MainController *-- AdminController&#xa;&#xa;    CustomerController o-- CustomerRepository&#xa;    CustomerController o-- OrderRepository&#xa;    DriverController o-- DriverRepository&#xa;    RestaurantController o-- RestaurantRepository&#xa;    RestaurantController o-- MenuItemRepository&#xa;    OrderController o-- OrderRepository&#xa;    OrderController o-- MenuItemRepository&#xa;    OrderController o-- DriverRepository&#xa;    AdminController o-- DriverApplicationRepository&#xa;    SimulatorController o-- SimulationRunRepository&#xa;}&#xa;&#xa;package &quot;4. Exception Layer&quot; {&#xa;    class FoodDeliveryException extends Exception {&#xa;        + FoodDeliveryException(message: String)&#xa;    }&#xa;&#xa;    class ConcurrencyException extends FoodDeliveryException {&#xa;        + ConcurrencyException(message: String)&#xa;    }&#xa;&#xa;    class DoubleAssignmentException extends ConcurrencyException {&#xa;        - String orderId&#xa;        - String existingDriverId&#xa;        - String attemptedDriverId&#xa;        + getOrderId(): String&#xa;    }&#xa;&#xa;    class DriverOverloadException extends ConcurrencyException {&#xa;        - String driverId&#xa;        - String currentOrderId&#xa;        + getDriverId(): String&#xa;    }&#xa;&#xa;    class OptimisticLockException extends ConcurrencyException {&#xa;        - String entityId&#xa;        - long expectedVersion&#xa;        - long currentVersion&#xa;        + getEntityId(): String&#xa;    }&#xa;&#xa;    class OversellException extends ConcurrencyException {&#xa;        - String menuItemId&#xa;        - int requestedQty&#xa;        - int availableQty&#xa;        + getMenuItemId(): String&#xa;    }&#xa;&#xa;    class EntityNotFoundException extends FoodDeliveryException {&#xa;        - String entityName&#xa;        - String entityId&#xa;    }&#xa;&#xa;    class InvalidInputException extends FoodDeliveryException {&#xa;        - String fieldName&#xa;    }&#xa;}&#xa;&#xa;package &quot;5. View Layer&quot; {&#xa;    interface IView {&#xa;        + display(): void&#xa;    }&#xa;&#xa;    class MainView implements IView {&#xa;        - MainController mainController&#xa;        + MainView(mainController: MainController)&#xa;        + display(): void&#xa;    }&#xa;&#xa;    class MapView {&#xa;        + renderAsciiMap(restaurants, customers, drivers): void&#xa;    }&#xa;&#xa;    class OrderView {&#xa;        + displayMenu(restaurant, items): void&#xa;        + displayRecentOrders(orders, count): void&#xa;    }&#xa;&#xa;    class ReportView {&#xa;        + printResearchConclusion(runs): void&#xa;        + renderSimulationSummary(run): void&#xa;    }&#xa;&#xa;    class SimulatorView {&#xa;        + printBenchmarkTable(runs): void&#xa;        + renderComparisonTable(runs): void&#xa;    }&#xa;&#xa;    MainController *-- MainView&#xa;    MainController *-- MapView&#xa;    MainController *-- OrderView&#xa;    MainController *-- ReportView&#xa;    MainController *-- SimulatorView&#xa;}&#xa;&#xa;' External Business Relationships&#xa;Order --&gt; Customer : places&#xa;Order --&gt; Restaurant : from&#xa;Order --&gt; Driver : delivered by&#xa;OrderItem --&gt; Order : belongs to&#xa;OrderItem --&gt; MenuItem : item&#xa;MenuItem --&gt; Restaurant : offered by&#xa;Driver --&gt; DriverStatus : status&#xa;Order --&gt; OrderStatus : status&#xa;User --&gt; UserRole : role&#xa;SimulationRun --&gt; LockMechanism : benchmarks&#xa;&#xa;@enduml&#xa;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UML_ROOT">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
