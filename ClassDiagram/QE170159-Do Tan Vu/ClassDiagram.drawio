<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="n0wF9s4adN9_pPq2yMLv">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam shadowing false\ntitle LAB211 Food Delivery - Class Diagram (MVC)\n\npackage model.entity {\n  abstract class BaseEntity {\n    # id : String\n    # createdAt : LocalDateTime\n    # updatedAt : LocalDateTime\n    + toCsvLine() : String\n  }\n  class Customer {\n    - name : String\n    - phone : String\n    - email : String\n    - address : String\n    - lat : double\n    - lon : double\n    + fromCsvLine(cols : String[]) : Customer\n  }\n  class Restaurant {\n    - name : String\n    - address : String\n    - lat : double\n    - lon : double\n    - status : RestaurantStatus\n    + fromCsvLine(cols : String[]) : Restaurant\n  }\n  class MenuItem {\n    - restaurantId : String\n    - name : String\n    - price : double\n    - stockQty : int\n    - version : long\n    + fromCsvLine(cols : String[]) : MenuItem\n  }\n  class Driver {\n    - name : String\n    - phone : String\n    - lat : double\n    - lon : double\n    - status : DriverStatus\n    - currentOrderId : String\n    - version : long\n    + fromCsvLine(cols : String[]) : Driver\n  }\n  class Order {\n    - customerId : String\n    - restaurantId : String\n    - driverId : String\n    - status : OrderStatus\n    - totalAmount : double\n    - version : long\n    - confirmedAt : LocalDateTime\n    + fromCsvLine(cols : String[]) : Order\n  }\n  class OrderItem {\n    - orderId : String\n    - menuItemId : String\n    - quantity : int\n    - unitPrice : double\n    + fromCsvLine(cols : String[]) : OrderItem\n  }\n  class DeliveryRoute {\n    - orderId : String\n    - driverId : String\n    - distanceKm : double\n    - etaMinutes : int\n    - pathSummary : String\n    + fromCsvLine(cols : String[]) : DeliveryRoute\n  }\n  class SimulationRun {\n    - runId : String\n    - mechanism : LockMechanism\n    - orderCount : int\n    - threadCount : int\n    - throughputOpsPerSec : double\n    - doubleAssignErrors : int\n    - oversellErrors : int\n    - driverOverloadErrors : int\n    - durationMs : long\n    + fromCsvLine(cols : String[]) : SimulationRun\n  }\n  BaseEntity &lt;|-- Customer\n  BaseEntity &lt;|-- Restaurant\n  BaseEntity &lt;|-- MenuItem\n  BaseEntity &lt;|-- Driver\n  BaseEntity &lt;|-- Order\n  BaseEntity &lt;|-- OrderItem\n  BaseEntity &lt;|-- DeliveryRoute\n  BaseEntity &lt;|-- SimulationRun\n  Customer \&quot;1\&quot; -- \&quot;0..*\&quot; Order\n  Restaurant \&quot;1\&quot; -- \&quot;0..*\&quot; Order\n  Restaurant \&quot;1\&quot; o-- \&quot;1..*\&quot; MenuItem\n  Order \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem\n  Order \&quot;0..1\&quot; -- \&quot;0..1\&quot; Driver\n  Order \&quot;0..1\&quot; -- \&quot;0..1\&quot; DeliveryRoute\n}\n\npackage model.enums {\n  enum OrderStatus { PENDING CONFIRMED ASSIGNED DELIVERING DELIVERED CANCELLED }\n  enum DriverStatus { OFFLINE AVAILABLE BUSY }\n  enum RestaurantStatus { OPEN CLOSED }\n  enum LockMechanism { NO_LOCK FILE_LOCK SYNCHRONIZED OPTIMISTIC }\n  Order --&gt; OrderStatus\n  Driver --&gt; DriverStatus\n  Restaurant --&gt; RestaurantStatus\n  SimulationRun --&gt; LockMechanism\n}\n\npackage model.util {\n  class GeoUtils &lt;&lt;utility&gt;&gt; {\n    + haversine(lat1, lon1, lat2, lon2) : double\n  }\n}\n\npackage model.dto {\n  class PlaceOrderRequest {\n    - customerId : String\n    - restaurantId : String\n    - items : List&lt;OrderLineRequest&gt;\n  }\n  class OrderLineRequest {\n    - menuItemId : String\n    - quantity : int\n  }\n  class DispatchResult {\n    - success : boolean\n    - orderId : String\n    - driverId : String\n    - distanceKm : double\n  }\n  class SimulationConfig {\n    - mechanism : LockMechanism\n    - totalOrders : int\n    - customerThreads : int\n    - dispatchThreads : int\n  }\n  PlaceOrderRequest *-- OrderLineRequest\n}\n\npackage model.exception {\n  abstract class FoodDeliveryException\n  class InsufficientStockException\n  class DoubleAssignmentException\n  class DriverOverloadException\n  class OptimisticLockConflictException\n  class OrderNotCancellableException\n  class CsvPersistenceException\n  FoodDeliveryException &lt;|-- InsufficientStockException\n  FoodDeliveryException &lt;|-- DoubleAssignmentException\n  FoodDeliveryException &lt;|-- DriverOverloadException\n  FoodDeliveryException &lt;|-- OptimisticLockConflictException\n  FoodDeliveryException &lt;|-- OrderNotCancellableException\n  FoodDeliveryException &lt;|-- CsvPersistenceException\n}\n\npackage repository {\n  class CsvRepository &lt;&lt;T&gt;&gt; {\n    # filePath : Path\n    + findAll() : List&lt;T&gt;\n    + findById(id : String) : Optional&lt;T&gt;\n    + save(entity : T) : void\n    # parseLine(line : String) : T\n    # writeAll(list : List&lt;T&gt;) : void\n  }\n  class CustomerRepository\n  class RestaurantRepository\n  class MenuItemRepository {\n    + deductStockWithSync(itemId, qty, mechanism) : void\n    + deductStockWithOptimistic(itemId, qty) : void\n    + findByRestaurantId(restaurantId) : List&lt;MenuItem&gt;\n  }\n  class DriverRepository {\n    + findNearestAvailable(lat, lon) : Optional&lt;Driver&gt;\n    + markBusyWithSync(driverId, orderId, mechanism) : void\n    + markAvailable(driverId) : void\n  }\n  class OrderRepository {\n    + create(order, items) : Order\n    + confirm(orderId) : void\n    + cancelIfPending(orderId) : void\n    + assignDriverWithSync(orderId, driverId, mechanism) : void\n    + assignDriverWithOptimistic(orderId, driverId) : void\n    + dispatchNearestDriver(orderId, lat, lon, mechanism) : DispatchResult\n    + markDelivered(orderId) : void\n  }\n  class OrderItemRepository\n  class DeliveryRouteRepository\n  class SimulationRunRepository\n  interface LockCoordinator {\n    + executeOnOrder(orderId, action) : void\n    + executeOnDriver(driverId, action) : void\n    + executeOnMenuItem(itemId, action) : void\n  }\n  class NoLockCoordinator\n  class FileLockCoordinator\n  class SynchronizedResourceCoordinator\n  class OptimisticVersionCoordinator\n  class LockCoordinatorFactory {\n    + create(mechanism) : LockCoordinator\n  }\n  class SimulationVerifier {\n    + detectDoubleAssignments() : int\n    + detectOversellItems() : int\n    + detectDriverOverload() : int\n  }\n  CsvRepository &lt;|-- CustomerRepository\n  CsvRepository &lt;|-- RestaurantRepository\n  CsvRepository &lt;|-- MenuItemRepository\n  CsvRepository &lt;|-- DriverRepository\n  CsvRepository &lt;|-- OrderRepository\n  CsvRepository &lt;|-- OrderItemRepository\n  CsvRepository &lt;|-- DeliveryRouteRepository\n  CsvRepository &lt;|-- SimulationRunRepository\n  LockCoordinator &lt;|.. NoLockCoordinator\n  LockCoordinator &lt;|.. FileLockCoordinator\n  LockCoordinator &lt;|.. SynchronizedResourceCoordinator\n  LockCoordinator &lt;|.. OptimisticVersionCoordinator\n  OrderRepository --&gt; DriverRepository\n  OrderRepository ..&gt; GeoUtils\n  DriverRepository ..&gt; GeoUtils\n  OrderRepository ..&gt; LockCoordinatorFactory\n  DriverRepository ..&gt; LockCoordinatorFactory\n  MenuItemRepository ..&gt; LockCoordinatorFactory\n}\n\npackage controller {\n  class CustomerController {\n    + register(...) : Customer\n    + getOrderHistory(customerId) : List&lt;Order&gt;\n  }\n  class RestaurantController {\n    + getMenu(restaurantId) : List&lt;MenuItem&gt;\n    + updateStock(itemId, qty) : void\n    + confirmOrder(orderId) : void\n  }\n  class DriverController {\n    + goOnline(driverId) : void\n    + goOffline(driverId) : void\n    + completeDelivery(orderId) : void\n  }\n  class OrderController {\n    + placeOrder(request, mechanism) : Order\n    + cancelOrder(orderId) : void\n    + requestDispatch(orderId, mechanism) : DispatchResult\n  }\n  class SimulatorController {\n    + runSimulation(config) : SimulationRun\n    + runAllMechanisms(config, reps) : List&lt;SimulationRun&gt;\n  }\n  CustomerController --&gt; CustomerRepository\n  CustomerController --&gt; OrderRepository\n  RestaurantController --&gt; RestaurantRepository\n  RestaurantController --&gt; MenuItemRepository\n  RestaurantController --&gt; OrderRepository\n  DriverController --&gt; DriverRepository\n  DriverController --&gt; OrderRepository\n  OrderController --&gt; OrderRepository\n  OrderController --&gt; MenuItemRepository\n  OrderController --&gt; OrderItemRepository\n  SimulatorController --&gt; OrderController\n  SimulatorController --&gt; OrderRepository\n  SimulatorController --&gt; SimulationRunRepository\n  SimulatorController --&gt; SimulationVerifier\n}\n\npackage view {\n  class MainView\n  class OrderView\n  class MapView\n  class SimulatorView\n  class ReportView\n  MainView ..&gt; CustomerController\n  MainView ..&gt; OrderController\n  MainView ..&gt; SimulatorController\n  OrderView ..&gt; OrderController\n  OrderView ..&gt; RestaurantController\n  MapView ..&gt; DriverController\n  SimulatorView ..&gt; SimulatorController\n  ReportView ..&gt; SimulatorController\n}\n\npackage concurrency {\n  class CustomerThread {\n    - orderController : OrderController\n    - latch : CountDownLatch\n    - mechanism : LockMechanism\n    + run() : void\n  }\n  class DispatchThread {\n    - orderRepository : OrderRepository\n    - latch : CountDownLatch\n    - mechanism : LockMechanism\n    + run() : void\n  }\n  SimulatorController o-- CustomerThread\n  SimulatorController o-- DispatchThread\n}\n\npackage bootstrap {\n  class DataGenerator {\n    + generateAll(outputDir) : void\n    + main(args) : void\n  }\n  class Main {\n    + main(args) : void\n  }\n  Main --&gt; MainView\n}\n\nnote bottom of MenuItem\n  menu_items.csv\n  hotspot + version\nend note\n\nnote bottom of Driver\n  drivers.csv\n  hotspot + version\nend note\n\nnote bottom of Order\n  orders.csv\n  hotspot + version\n  dispatch logic ONLY here\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Zii1KwOreU4teFXHWSF1-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
