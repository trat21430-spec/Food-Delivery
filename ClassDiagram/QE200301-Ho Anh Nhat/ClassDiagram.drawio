  <diagram id="M4EIHimKQzU5S0k71lYR" name="Page-2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Food Delivery Network (Full Details)\n\ntop to bottom direction\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam nodesep 50\nskinparam ranksep 60\nskinparam linetype polyline\nskinparam class {\n    BackgroundColor White\n    ArrowColor #2c3e50\n    BorderColor #505050\n}\n\n&#39; ===============================================\n&#39; 1. VIEW \n&#39; ===============================================\npackage \&quot;view\&quot; {\n    class MainView {\n        + start() : void\n        - printMainMenu() : void\n        - handleViewRestaurants() : void\n        - handlePlaceOrder() : void\n        - handleDispatchOrders() : void\n        - handleViewMap() : void\n        + handleRunSimulator() : void\n        + runAutomatedBenchmark(orders : int) : void\n        - handleViewReports() : void\n    }\n    class OrderView {\n        + {static} displayRestaurants(restaurants : List&lt;Restaurant&gt;) : void\n        + {static} displayMenu(restaurantName : String, menuItems : List&lt;MenuItem&gt;) : void\n        + {static} displayOrderReceipt(order : Order, items : List&lt;OrderItem&gt;) : void\n        - {static} truncate(text : String, maxLen : int) : String\n    }\n    class MapView {\n        + {static} renderMap(restaurants : List&lt;Restaurant&gt;, drivers : List&lt;Driver&gt;, customers : List&lt;Customer&gt;) : void\n        - {static} mapToGrid(lat : double, lng : double, minLat : double, maxLat : double, minLng : double, maxLng : double) : int[]\n    }\n    class SimulatorView {\n        + {static} displayBenchmarkHeader() : void\n        + {static} displayResultRow(res : SimulationResult) : void\n        + {static} displayBenchmarkFooter() : void\n        - {static} printSeparator() : void\n        + {static} displayConclusion(results : List&lt;SimulationResult&gt;) : void\n    }\n    class ReportView {\n        + {static} displayReportSummary(runs : List&lt;SimulationRun&gt;) : void\n        + {static} displayThroughputChart(runs : List&lt;SimulationRun&gt;) : void\n    }\n}\n\n&#39; ===============================================\n&#39; 2. CONTROLLER\n&#39; ===============================================\npackage \&quot;controller\&quot; {\n    class CustomerController {\n        + getCustomer(id : String) : Customer\n        + getAllCustomers() : List&lt;Customer&gt;\n        + registerCustomer(customer : Customer) : void\n    }\n    class RestaurantController {\n        + getRestaurant(id : String) : Restaurant\n        + getAllRestaurants() : List&lt;Restaurant&gt;\n        + getMenuItems(restaurantId : String) : List&lt;MenuItem&gt;\n        + getMenuItem(itemId : String) : MenuItem\n        + updateStock(itemId : String, newStock : int) : void\n    }\n    class DriverController {\n        + getDriver(id : String) : Driver\n        + getAllDrivers() : List&lt;Driver&gt;\n        + setDriverStatus(driverId : String, status : Enums.DriverStatus) : void\n    }\n    class ReportController {\n        + getAllSimulationRuns() : List&lt;SimulationRun&gt;\n    }\n    class OrderController {\n        + placeOrder(cId : String, rId : String, items : Map&lt;String, Integer&gt;, mech : SimulationMechanism) : Order\n        + dispatchPendingOrder(orderId : String, mech : SimulationMechanism) : boolean\n        + cancelOrder(orderId : String, mech : SimulationMechanism) : boolean\n    }\n    class SimulatorController {\n        + runSimulation(mech : SimulationMechanism, orders : int, cThreads : int, dThreads : int, baseTp : double) : SimulationResult\n        + detectDoubleAssignments(ordersCsv : String) : int\n        + detectOversellItems(menuCsv : String) : int\n        + detectDriverOverload(driversCsv : String) : int\n    }\n}\n\n&#39; ===============================================\n&#39; 3. CONCURRENCY\n&#39; ===============================================\npackage \&quot;concurrency\&quot; {\n    class CustomerThread &lt;&lt;Runnable&gt;&gt; {\n        - startLatch : CountDownLatch\n        - doneLatch : CountDownLatch\n        - orderRepo : OrderRepository\n        - menuRepo : MenuItemRepository\n        - ordersToGenerate : int\n        + CustomerThread(startLatch : CountDownLatch, doneLatch : CountDownLatch, orderRepo : OrderRepository, menuRepo : MenuItemRepository, ordersToGenerate : int)\n        + run() : void\n    }\n    class DispatchThread &lt;&lt;Runnable&gt;&gt; {\n        - startLatch : CountDownLatch\n        - doneLatch : CountDownLatch\n        - orderRepo : OrderRepository\n        - mechanism : SimulationMechanism\n        + DispatchThread(startLatch : CountDownLatch, doneLatch : CountDownLatch, orderRepo : OrderRepository, mechanism : SimulationMechanism)\n        + run() : void\n    }\n}\n\n&#39; ===============================================\n&#39; 4. REPOSITORY (Cập nhật chuẩn 100% từ Code gốc)\n&#39; ===============================================\npackage \&quot;repository\&quot; {\n    abstract class CsvRepository&lt;T extends BaseEntity&gt; {\n        # filePath : String\n        # entityMap : Map&lt;String, T&gt;\n        + CsvRepository(filePath : String)\n        # {abstract} createEntity() : T\n        # {abstract} getHeader() : String\n        + withPhysicalFileLock(action : FileLockAction&lt;R&gt;) : R\n        + getResourceLock(key : String) : Object\n        + loadFromFile() : void\n        + saveToFile() : void\n        + findById(id : String) : T\n        + findAll() : List&lt;T&gt;\n        + save(entity : T) : void\n        + delete(id : String) : void\n    }\n    \n    class CustomerRepository {\n        + CustomerRepository(filePath : String)\n        # createEntity() : Customer\n        # getHeader() : String\n    }\n    class RestaurantRepository {\n        + RestaurantRepository(filePath : String)\n        # createEntity() : Restaurant\n        # getHeader() : String\n    }\n    class OrderItemRepository {\n        + OrderItemRepository(filePath : String)\n        # createEntity() : OrderItem\n        # getHeader() : String\n        + findByOrderId(orderId : String) : List&lt;OrderItem&gt;\n    }\n    class DeliveryRouteRepository {\n        + DeliveryRouteRepository(filePath : String)\n        # createEntity() : DeliveryRoute\n        # getHeader() : String\n    }\n    class SimulationRunRepository {\n        + SimulationRunRepository(filePath : String)\n        # createEntity() : SimulationRun\n        # getHeader() : String\n    }\n    \n    class MenuItemRepository {\n        + MenuItemRepository(filePath : String)\n        # createEntity() : MenuItem\n        # getHeader() : String\n        + deductStock(itemId : String, qty : int, mech : SimulationMechanism, version : int) : void\n        + deductStockNoLock(item : MenuItem, qty : int) : void\n        + deductStockWithFileLock(itemId : String, qty : int) : void\n        + deductStockWithSync(itemId : String, qty : int) : void\n        + deductStockWithOptimistic(itemId : String, qty : int, version : int) : void\n    }\n\n    class DriverRepository {\n        + DriverRepository(filePath : String)\n        # createEntity() : Driver\n        # getHeader() : String\n        + findNearestAvailable(lat : double, lon : double) : Driver\n        + markBusy(driverId : String, orderId : String, mech : SimulationMechanism, version : int) : void\n        + releaseDriver(driverId : String) : void\n    }\n\n    class OrderRepository {\n        + OrderRepository(filePath : String)\n        # createEntity() : Order\n        # getHeader() : String\n        + dispatchOrder(orderId : String, dRepo : DriverRepository, rRepo : RestaurantRepository, mech : SimulationMechanism) : boolean\n        + assignDriverWithSync(orderId : String, driverId : String, dRepo : DriverRepository) : void\n        + assignDriverWithOptimistic(orderId : String, driverId : String, v : int, dRepo : DriverRepository, dv : int) : void\n        + cancelOrder(orderId : String, dRepo : DriverRepository, mech : SimulationMechanism) : boolean\n    }\n}\n\n&#39; ===============================================\n&#39; 5. MODEL\n&#39; ===============================================\npackage \&quot;model\&quot; {\n    abstract class BaseEntity {\n        # id : String\n        + BaseEntity()\n        + BaseEntity(id : String)\n        + getId() : String\n        + setId(id : String) : void\n        + {abstract} toCsvLine() : String\n        + {abstract} fromCsvLine(csvLine : String) : void\n    }\n    class Customer {\n        - name : String\n        - phone : String\n        - latitude : double\n        - longitude : double\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class Restaurant {\n        - name : String\n        - address : String\n        - latitude : double\n        - longitude : double\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class MenuItem {\n        - restaurantId : String\n        - name : String\n        - price : double\n        - stockQty : int\n        - version : int\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class Driver {\n        - name : String\n        - phone : String\n        - latitude : double\n        - longitude : double\n        - status : DriverStatus\n        - currentOrderId : String\n        - version : int\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class Order {\n        - customerId : String\n        - restaurantId : String\n        - driverId : String\n        - status : OrderStatus\n        - orderTime : String\n        - deliveryFee : double\n        - totalAmount : double\n        - version : int\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class OrderItem {\n        - orderId : String\n        - menuItemId : String\n        - quantity : int\n        - unitPrice : double\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class DeliveryRoute {\n        - orderId : String\n        - driverId : String\n        - startLat : double\n        - startLng : double\n        - endLat : double\n        - endLng : double\n        - distanceKm : double\n        - status : String\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n    class SimulationRun {\n        - mechanism : SimulationMechanism\n        - totalOrders : int\n        - durationMs : long\n        - throughput : double\n        - doubleAssignments : int\n        - oversellErrors : int\n        - driverOverloads : int\n        - throughputDropPercent : double\n        - timestamp : String\n        + toCsvLine() : String\n        + fromCsvLine(csvLine : String) : void\n    }\n}\n\n&#39; ===============================================\n&#39; 6. UTILS, ENUMS &amp; EXCEPTIONS (Full)\n&#39; ===============================================\npackage \&quot;Utils, Enums &amp; Exceptions\&quot; {\n    class GeoUtils {\n        + {static} EARTH_RADIUS_KM : double = 6371.0\n        + {static} haversine(lat1 : double, lon1 : double, lat2 : double, lon2 : double) : double\n        + {static} estimatedDrivingDistance(lat1 : double, lon1 : double, lat2 : double, lon2 : double) : double\n    }\n    \n    enum OrderStatus {\n        PENDING\n        ASSIGNED\n        DELIVERED\n        CANCELLED\n    }\n    enum DriverStatus {\n        AVAILABLE\n        BUSY\n        OFFLINE\n    }\n    enum SimulationMechanism {\n        NO_LOCK\n        FILE_LOCK\n        SYNCHRONIZED\n        OPTIMISTIC\n    }\n    \n    class DoubleAssignmentException &lt;&lt;Exception&gt;&gt; {\n        + DoubleAssignmentException(message : String)\n    }\n    class DriverOverloadException &lt;&lt;Exception&gt;&gt; {\n        + DriverOverloadException(message : String)\n    }\n    class EntityNotFoundException &lt;&lt;Exception&gt;&gt; {\n        + EntityNotFoundException(message : String)\n    }\n    class OptimisticLockException &lt;&lt;Exception&gt;&gt; {\n        + OptimisticLockException(message : String)\n    }\n    class OversellException &lt;&lt;Exception&gt;&gt; {\n        + OversellException(message : String)\n    }\n}\n\n&#39; Ép sơ đồ đứng dọc theo tầng kiến trúc\nview -[hidden]down-&gt; controller\ncontroller -[hidden]down-&gt; repository\nrepository -[hidden]down-&gt; model\nmodel -[hidden]down-&gt; \&quot;Utils, Enums &amp; Exceptions\&quot;\n\n&#39; Kế thừa Repository\nCsvRepository &lt;|-- CustomerRepository\nCsvRepository &lt;|-- RestaurantRepository\nCsvRepository &lt;|-- MenuItemRepository\nCsvRepository &lt;|-- DriverRepository\nCsvRepository &lt;|-- OrderRepository\nCsvRepository &lt;|-- OrderItemRepository\nCsvRepository &lt;|-- DeliveryRouteRepository\nCsvRepository &lt;|-- SimulationRunRepository\n\n&#39; Kế thừa Model\nBaseEntity &lt;|-- Customer\nBaseEntity &lt;|-- Restaurant\nBaseEntity &lt;|-- MenuItem\nBaseEntity &lt;|-- Driver\nBaseEntity &lt;|-- Order\nBaseEntity &lt;|-- OrderItem\nBaseEntity &lt;|-- DeliveryRoute\nBaseEntity &lt;|-- SimulationRun\n\n&#39; Mối quan hệ giữa thực thể\nRestaurant \&quot;1\&quot; *-- \&quot;1..*\&quot; MenuItem : manages &gt;\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : contains &gt;\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Order : places &gt;\nDriver \&quot;1\&quot; -- \&quot;0..1\&quot; Order : delivers &gt;\n\n&#39; Quan hệ gọi hàm\nOrderRepository ..&gt; DriverRepository : uses &gt;\nOrderRepository ..&gt; RestaurantRepository : uses &gt;\nOrderRepository ..&gt; GeoUtils : uses &gt;\n\nOrderController --&gt; OrderRepository : coordinates &gt;\nSimulatorController --&gt; OrderRepository : simulates &gt;\nSimulatorController --&gt; DriverRepository : simulates &gt;\nSimulatorController --&gt; MenuItemRepository : simulates &gt;\n\nMainView --&gt; OrderController : interacts &gt;\nMainView --&gt; SimulatorController : interacts &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="h-2nmfwI7UCY_sYXI8Ro-3353">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
