  <diagram name="Page-1" id="wadyvZskco1s_vdb4qxw">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\nskinparam linetype ortho\nskinparam nodesep 30\nskinparam ranksep 40\nskinparam classAttributeIconSize 0\n\npackage \&quot;1. View Layer\&quot; {\n    class MainView {\n        + displayMainMenu() : void\n        + readUserInput() : String\n    }\n    class OrderView {\n        + displayMenu(items: List&lt;MenuItem&gt;) : void\n        + displayOrderStatus(order: Order) : void\n    }\n    class MapView {\n        + renderAsciiMap(...) : void\n    }\n    class SimulatorView {\n        + displaySimulationForm() : void\n        + displayResults(...) : void\n    }\n    class ReportView {\n        + generateReport(run: SimulationRun) : void\n    }\n    \n    &#39; Ép View xếp thành 2 cột dọc\n    MainView -[hidden]down-&gt; MapView\n    OrderView -[hidden]down-&gt; SimulatorView\n}\n\npackage \&quot;2. Controller Layer\&quot; {\n    class CustomerController {\n        + register(customer: Customer) : void\n        + getOrderHistory(customerId: String) : List&lt;Order&gt;\n    }\n    class RestaurantController {\n        + getMenu(restaurantId: String) : List&lt;MenuItem&gt;\n        + updateStock(itemId: String, qty: int) : void\n    }\n    class DriverController {\n        + goOnline(driverId: String) : void\n        + goOffline(driverId: String) : void\n        + getNearestDriver(lat, lon) : Driver\n    }\n    class OrderController {\n        + placeOrder(order, items) : void\n        + dispatchDriver(orderId, mechanism) : void\n    }\n    class SimulatorController {\n        - OrderController orderController\n        + startSimulation(threads, mechanism) : void\n        + detectDoubleAssignments() : int\n        + detectOversellItems() : int\n        + detectDriverOverload() : int\n    }\n    \n    &#39; Ép Controller xếp dọc\n    CustomerController -[hidden]down-&gt; DriverController\n    RestaurantController -[hidden]down-&gt; OrderController\n}\n\npackage \&quot;3. Repository Layer\&quot; {\n    abstract class CsvRepository&lt;T&gt; {\n        # String filePath\n        + save(entity: T) : void\n        + findById(id: String) : T\n        + findAll() : List&lt;T&gt;\n        + delete(id: String) : void\n        # saveWithVersionCheck(entity: T, currentVersion: int) : boolean\n    }\n\n    class CustomerRepository\n    class RestaurantRepository\n    class OrderItemRepository\n    class DeliveryRouteRepository\n    class SimulationRunRepository\n    class MenuItemRepository {\n        + deductStockWithSync(itemId, qty) : void\n    }\n    class DriverRepository {\n        + markBusyWithSync(driverId: String) : void\n        + findNearestAvailable(lat, lon) : Driver\n    }\n    class OrderRepository {\n        + assignDriverWithSync(orderId, driverId) : void\n        + assignDriverWithOptimistic(orderId, driverId) : void\n    }\n    \n    CsvRepository &lt;|-- CustomerRepository\n    CsvRepository &lt;|-- RestaurantRepository\n    CsvRepository &lt;|-- MenuItemRepository\n    CsvRepository &lt;|-- DriverRepository\n    CsvRepository &lt;|-- OrderRepository\n    CsvRepository &lt;|-- OrderItemRepository\n    CsvRepository &lt;|-- DeliveryRouteRepository\n    CsvRepository &lt;|-- SimulationRunRepository\n    \n    &#39; Ép Repo xếp thành các cột dọc để không phình ngang\n    CustomerRepository -[hidden]down-&gt; OrderItemRepository\n    RestaurantRepository -[hidden]down-&gt; DeliveryRouteRepository\n    MenuItemRepository -[hidden]down-&gt; SimulationRunRepository\n}\n\npackage \&quot;4. Model Layer\&quot; {\n    abstract class BaseEntity {\n        # String id\n        + getId() : String\n        + setId(id: String) : void\n        + {abstract} toCsvLine() : String\n        + {abstract} fromCsvLine(line: String) : void\n    }\n\n    class Customer {\n        - String name\n        - String phone\n        - double locationX\n        - double locationY\n    }\n    class Restaurant {\n        - String name\n        - double locationX\n        - double locationY\n    }\n    class MenuItem {\n        - String restaurantId\n        - String name\n        - double price\n        - int stockQty\n        - int version\n    }\n    class Driver {\n        - String name\n        - double locationX\n        - double locationY\n        - DriverStatus status\n        - int version\n    }\n    class Order {\n        - String customerId\n        - String restaurantId\n        - String driverId\n        - OrderStatus status\n        - long orderTime\n        - int version\n    }\n    class OrderItem {\n        - String orderId\n        - String menuItemId\n        - int quantity\n        - double price\n    }\n    class DeliveryRoute {\n        - String orderId\n        - double distance\n        - double estimatedTime\n    }\n    class SimulationRun {\n        - long runTime\n        - String mechanism\n        - double throughput\n        - int oversellErrors\n        - int doubleAssignErrors\n        - int overloadErrors\n    }\n\n    class GeoUtils &lt;&lt;utility&gt;&gt; {\n        + {static} haversine(lat1, lon1, lat2, lon2) : double\n    }\n\n    enum OrderStatus {\n        PENDING, ASSIGNED, DELIVERED, CANCELLED\n    }\n\n    enum DriverStatus {\n        AVAILABLE, BUSY, OFFLINE\n    }\n    \n    BaseEntity &lt;|-- Customer\n    BaseEntity &lt;|-- Restaurant\n    BaseEntity &lt;|-- MenuItem\n    BaseEntity &lt;|-- Driver\n    BaseEntity &lt;|-- Order\n    BaseEntity &lt;|-- OrderItem\n    BaseEntity &lt;|-- DeliveryRoute\n    BaseEntity &lt;|-- SimulationRun\n    \n    &#39; Ép Model xếp thành 2 cột để khuôn sơ đồ hẹp lại\n    Customer -[hidden]down-&gt; Order\n    Restaurant -[hidden]down-&gt; OrderItem\n    MenuItem -[hidden]down-&gt; DeliveryRoute\n    Driver -[hidden]down-&gt; SimulationRun\n}\n\npackage \&quot;5. Exception Layer\&quot; {\n    class ConcurrencyException &lt;&lt;Exception&gt;&gt;\n    class OversellException\n    class DoubleAssignmentException\n    class DriverOverloadException\n    class OptimisticLockException\n    class EntityNotFoundException\n    \n    ConcurrencyException &lt;|-- OversellException\n    ConcurrencyException &lt;|-- DoubleAssignmentException\n    ConcurrencyException &lt;|-- DriverOverloadException\n    ConcurrencyException &lt;|-- OptimisticLockException\n    \n    &#39; Ép Exception xếp 2 cột\n    OversellException -[hidden]down-&gt; OptimisticLockException\n    DoubleAssignmentException -[hidden]down-&gt; EntityNotFoundException\n}\n\n&#39; ==========================================\n&#39; Ép các khối Layer chồng lên nhau theo trục dọc (Tương thích 100% với Draw.io)\n&#39; ==========================================\nMainView -[hidden]down-&gt; CustomerController\nCustomerController -[hidden]down-&gt; CsvRepository\nCsvRepository -[hidden]down-&gt; BaseEntity\nBaseEntity -[hidden]down-&gt; ConcurrencyException\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Nxg3U9515UqMr4NUZRn2-1">
