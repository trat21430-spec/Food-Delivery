  <diagram id="Xg69b8ri2g6QPkKwZynH" name="Page-3">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\n%% =========================\n%% VIEW LAYER\n%% =========================\n\nclass MainView {\n    +showMenu() : void\n}\n\nclass OrderView {\n    +showOrder() : void\n    +showStatus() : void\n}\n\nclass MapView {\n    +showMap() : void\n}\n\nclass SimulatorView {\n    +showSimulation() : void\n}\n\nclass ReportView {\n    +showReport() : void\n}\n\n\n%% =========================\n%% CONTROLLER LAYER\n%% =========================\n\nclass CustomerController {\n    +createCustomer() : void\n    +viewOrders() : void\n}\n\nclass RestaurantController {\n    +viewMenu() : void\n    +updateStock() : void\n}\n\nclass DriverController {\n    +viewDrivers() : void\n    +findNearestDriver() : Driver\n}\n\nclass OrderController {\n    +createOrder() : void\n    +confirmOrder() : void\n    +cancelOrder() : void\n    +assignDriver() : void\n}\n\nclass SimulatorController {\n    +startSimulation() : void\n    +showResult() : void\n}\n\n\n%% =========================\n%% REPOSITORY LAYER\n%% =========================\n\nclass CsvRepository~T~ {\n    &lt;&lt;abstract&gt;&gt;\n    +save(entity : T) : void\n    +findById(id : String) : T\n    +findAll() : List~T~\n    +update(entity : T) : void\n    +delete(id : String) : void\n}\n\nclass CustomerRepository\n\nclass RestaurantRepository\n\nclass MenuItemRepository {\n    +deductStockWithSync(itemId : String, qty : int) : boolean\n}\n\nclass DriverRepository {\n    +findNearestAvailable(lat : double, lon : double) : Driver\n    +markBusyWithSync(driverId : String) : boolean\n}\n\nclass OrderRepository {\n    +assignDriverWithSync(orderId : String, driverId : String) : boolean\n    +assignDriverWithOptimistic(orderId : String, driverId : String) : boolean\n}\n\nclass OrderItemRepository\n\nclass DeliveryRouteRepository\n\n\nCsvRepository~T~ &lt;|-- CustomerRepository\nCsvRepository~T~ &lt;|-- RestaurantRepository\nCsvRepository~T~ &lt;|-- MenuItemRepository\nCsvRepository~T~ &lt;|-- DriverRepository\nCsvRepository~T~ &lt;|-- OrderRepository\nCsvRepository~T~ &lt;|-- OrderItemRepository\nCsvRepository~T~ &lt;|-- DeliveryRouteRepository\n\n\n%% =========================\n%% MODEL LAYER\n%% =========================\n\nclass BaseEntity {\n    &lt;&lt;abstract&gt;&gt;\n    -id : String\n}\n\nclass Customer {\n    -name : String\n    -phone : String\n    -email : String\n    -latitude : double\n    -longitude : double\n}\n\nclass Restaurant {\n    -name : String\n    -address : String\n    -latitude : double\n    -longitude : double\n}\n\nclass MenuItem {\n    -name : String\n    -price : double\n    -stock : int\n    -version : int\n}\n\nclass Driver {\n    -name : String\n    -phone : String\n    -status : DriverStatus\n    -latitude : double\n    -longitude : double\n    -version : int\n}\n\nclass Order {\n    -customerId : String\n    -restaurantId : String\n    -driverId : String\n    -status : OrderStatus\n    -totalAmount : double\n    -version : int\n}\n\nclass OrderItem {\n    -orderId : String\n    -menuItemId : String\n    -quantity : int\n    -unitPrice : double\n}\n\nclass DeliveryRoute {\n    -orderId : String\n    -driverId : String\n    -distance : double\n    -estimatedTime : double\n}\n\nclass SimulationRun {\n    -mechanism : String\n    -totalOrders : int\n    -conflicts : int\n    -throughput : double\n}\n\nclass GeoUtils {\n    &lt;&lt;utility&gt;&gt;\n    +haversine() : double\n}\n\nclass OrderStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    PENDING\n    CONFIRMED\n    ASSIGNED\n    DELIVERED\n    CANCELLED\n}\n\nclass DriverStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    AVAILABLE\n    BUSY\n}\n\n\nBaseEntity &lt;|-- Customer\nBaseEntity &lt;|-- Restaurant\nBaseEntity &lt;|-- MenuItem\nBaseEntity &lt;|-- Driver\nBaseEntity &lt;|-- Order\nBaseEntity &lt;|-- OrderItem\nBaseEntity &lt;|-- DeliveryRoute\nBaseEntity &lt;|-- SimulationRun\n\nRestaurant \&quot;1\&quot; --&gt; \&quot;1..*\&quot; MenuItem\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Order\nRestaurant \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Order\nOrder \&quot;1\&quot; --&gt; \&quot;1..*\&quot; OrderItem\nOrderItem --&gt; MenuItem\nOrder \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Driver\nOrder \&quot;1\&quot; --&gt; \&quot;0..1\&quot; DeliveryRoute\nDriver --&gt; DeliveryRoute\n\n\n%% =========================\n%% SYNCHRONIZATION\n%% =========================\n\nclass SyncMechanism {\n    &lt;&lt;enumeration&gt;&gt;\n    NO_LOCK\n    FILE_LOCK\n    SYNCHRONIZED\n    OPTIMISTIC\n}\n\nclass LockManager {\n    &lt;&lt;interface&gt;&gt;\n    +lock() : void\n    +unlock() : void\n}\n\nclass OptimisticLockManager {\n    +checkVersion() : boolean\n    +increaseVersion() : int\n}\n\n\n%% =========================\n%% SIMULATOR\n%% =========================\n\nclass CustomerThread {\n    +run() : void\n}\n\nclass DispatchThread {\n    +run() : void\n    +dispatchOrders() : void\n}\n\nclass SimulationVerifier {\n    +detectDoubleAssignments() : int\n    +detectOversellItems() : int\n    +detectDriverOverload() : int\n}\n\n\nCustomerThread --&gt; OrderController\nDispatchThread --&gt; DriverRepository\nDispatchThread --&gt; OrderRepository\n\nSimulatorController --&gt; CustomerThread\nSimulatorController --&gt; DispatchThread\nSimulatorController --&gt; SimulationVerifier\n\n\n%% =========================\n%% MAIN CONNECTIONS\n%% =========================\n\nMainView --&gt; CustomerController\nMainView --&gt; RestaurantController\nMainView --&gt; DriverController\nMainView --&gt; OrderController\nMainView --&gt; SimulatorController\n\nOrderView --&gt; OrderController\nMapView --&gt; DriverController\nSimulatorView --&gt; SimulatorController\nReportView --&gt; SimulatorController\n\nCustomerController --&gt; CustomerRepository\nRestaurantController --&gt; RestaurantRepository\nDriverController --&gt; DriverRepository\n\nOrderController --&gt; OrderRepository\nOrderController --&gt; MenuItemRepository\nOrderController --&gt; DriverRepository\n\nMenuItemRepository ..&gt; LockManager\nDriverRepository ..&gt; LockManager\nOrderRepository ..&gt; LockManager\nOrderRepository ..&gt; OptimisticLockManager&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Z7T0midhRuSDhVx_qXk_-1145">
