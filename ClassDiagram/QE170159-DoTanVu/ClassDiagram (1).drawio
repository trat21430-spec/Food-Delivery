        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam backgroundColor #ffffff\nskinparam class {\n    BackgroundColor #F8FAFC\n    BorderColor #475569\n    HeaderBackgroundColor #E2E8F0\n}\n\nenum DriverStatus {\n  OFFLINE\n  AVAILABLE\n  BUSY\n}\n\nenum OrderStatus {\n  PENDING\n  CONFIRMED\n  ASSIGNED\n  DELIVERED\n  CANCELLED\n  REJECTED\n}\n\nclass Customer {\n  - customerId : String\n  - name : String\n  - phone : String\n  - email : String\n  - latitude : double\n  - longitude : double\n  + placeOrder() : Order\n  + viewOrders() : List&lt;Order&gt;\n  + cancelOrder(orderId : String) : boolean\n}\n\nclass Restaurant {\n  - restaurantId : String\n  - name : String\n  - address : String\n  - latitude : double\n  - longitude : double\n  + addMenuItem(item : MenuItem) : void\n  + updateMenuItem(item : MenuItem) : void\n  + deleteMenuItem(itemId : String) : void\n  + updateStock(itemId : String, stock : int) : void\n  + confirmOrder(orderId : String) : void\n}\n\nclass MenuItem {\n  - itemId : String\n  - restaurantId : String\n  - name : String\n  - price : double\n  - stock : int\n  - version : long {Optimistic Lock}\n  + isAvailable(qty : int) : boolean\n  + deductStock(qty : int) : boolean\n  + increaseStock(qty : int) : void\n}\n\nclass Driver {\n  - driverId : String\n  - name : String\n  - phone : String\n  - latitude : double\n  - longitude : double\n  - status : DriverStatus\n  - version : long {Optimistic Lock}\n  + updateLocation(lat : double, lon : double) : void\n  + setAvailable() : void\n  + setBusy() : void\n  + acceptOrder(orderId : String) : void\n  + completeDelivery(orderId : String) : void\n}\n\nclass Order {\n  - orderId : String\n  - customerId : String\n  - restaurantId : String\n  - driverId : String\n  - status : OrderStatus\n  - totalAmount : double\n  - createdAt : LocalDateTime\n  - confirmedAt : LocalDateTime\n  - version : long {Optimistic Lock}\n  + addItem(item : OrderItem) : void\n  + calculateTotal() : double\n  + confirm() : void\n  + cancel() : void\n  + assignDriver(driverId : String) : void\n  + markDelivered() : void\n}\n\nclass OrderItem {\n  - orderId : String\n  - menuItemId : String\n  - quantity : int\n  - unitPrice : double\n  + getSubtotal() : double\n}\n\nclass DeliveryRoute {\n  - routeId : String\n  - orderId : String\n  - driverId : String\n  - distanceKm : double\n  - estimatedMinutes : int\n  + calculateDistance(lat1: double, lon1: double, lat2: double, lon2: double) : double\n  + estimateTime() : int\n}\n\nCustomer \&quot;1\&quot; -- \&quot;*\&quot; Order : places &gt;\nRestaurant \&quot;1\&quot; -- \&quot;*\&quot; MenuItem : offers &gt;\nOrder \&quot;1\&quot; -- \&quot;*\&quot; OrderItem : contains &gt;\nMenuItem \&quot;1\&quot; -- \&quot;*\&quot; OrderItem : references &gt;\nDriver \&quot;1\&quot; -- \&quot;*\&quot; Order : delivers &gt;\nOrder \&quot;1\&quot; -- \&quot;1\&quot; DeliveryRoute : routes &gt;\nDriver \&quot;1\&quot; -- \&quot;*\&quot; DeliveryRoute : executes &gt;\n\nDriver --&gt; DriverStatus\nOrder --&gt; OrderStatus\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UbHox0al1M1n2W4GO_Fq-1">
