        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\nskinparam backgroundColor #ffffff\nskinparam usecase {\n    BackgroundColor #FFF7ED\n    BorderColor #EA580C\n}\n\nactor \&quot;🛍️ Customer\&quot; as c #0284c7\nactor \&quot;🍽️ Restaurant\&quot; as r #d97706\nactor \&quot;🛵 Driver\&quot; as d #16a34a\nactor \&quot;📡 Dispatcher\&quot; as dp #9333ea\n\nrectangle \&quot;🍔 Food Delivery Network Simulation System\&quot; {\n  \n  package \&quot;Customer Functions\&quot; {\n    (View Menu) as UC_VM\n    (Place Order) as UC_PO\n    (Check Stock) as UC_CS\n    (Deduct Stock) as UC_DS\n    (View Order Status) as UC_VOS\n    (View Order History) as UC_VOH\n    (Cancel Order) as UC_CO\n  }\n\n  package \&quot;Restaurant Functions\&quot; {\n    (Manage Menu) as UC_MM\n    (Update Stock) as UC_US\n    (View Orders) as UC_VO\n    (Confirm Order) as UC_CRO\n  }\n\n  package \&quot;Driver Functions\&quot; {\n    (Update Availability) as UC_UA\n    (View Assigned Order) as UC_VAO\n    (Accept Order) as UC_AO\n    (Deliver Order) as UC_DO\n  }\n\n  package \&quot;Dispatcher Functions\&quot; {\n    (Dispatch Order) as UC_DPO\n    (Find Available Driver) as UC_FAD\n    (Calculate Haversine Distance) as UC_CD\n    (Find Nearest Driver) as UC_FND\n    (Assign Driver) as UC_AD\n  }\n}\n\nc --&gt; UC_VM\nc --&gt; UC_PO\nc --&gt; UC_VOS\nc --&gt; UC_VOH\nc --&gt; UC_CO\n\nUC_PO ..&gt; UC_CS : &lt;&lt;include&gt;&gt;\nUC_PO ..&gt; UC_DS : &lt;&lt;include&gt;&gt;\n\nr --&gt; UC_MM\nr --&gt; UC_US\nr --&gt; UC_VO\nr --&gt; UC_CRO\n\nd --&gt; UC_UA\nd --&gt; UC_VAO\nd --&gt; UC_AO\nd --&gt; UC_DO\n\ndp --&gt; UC_DPO\nUC_DPO ..&gt; UC_FAD : &lt;&lt;include&gt;&gt;\nUC_DPO ..&gt; UC_CD : &lt;&lt;include&gt;&gt;\nUC_DPO ..&gt; UC_FND : &lt;&lt;include&gt;&gt;\nUC_DPO ..&gt; UC_AD : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YUW3mc5jE_xzTUyiVdFh-41">
